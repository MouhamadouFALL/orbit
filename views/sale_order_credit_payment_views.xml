<odoo>
    <record id="view_sale_order_credit_payment_tree" model="ir.ui.view">
        <field name="name">sale.order.credit.payment.tree</field>
        <field name="model">sale.order.credit.payment</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence"/>
                <field name="due_date"/>
                <field name="rate"/>
                <field name="amount"/>
                <field name="is_amount_manual"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sale_order_credit_payment_form" model="ir.ui.view">
        <field name="name">sale.order.credit.payment.form</field>
        <field name="model">sale.order.credit.payment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="due_date"/>
                        <field name="rate"/>
                        <field name="amount"/>
                        <field name="is_amount_manual"/>
                        <field name="state" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action pour tester ou isoler la vue -->
    <record id="action_sale_order_credit_payment" model="ir.actions.act_window">
        <field name="name">Échéances de Paiement Crédit</field>
        <field name="res_model">sale.order.credit.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
    </record>
</odoo>
