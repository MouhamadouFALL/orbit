<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ************************************ Inherit Form view sale order ************************************ -->
    <record id="view_orbit_stock_warehouse_form" model="ir.ui.view">
        <field name="name">orbit.stock.wareouse.form.inherited</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='warehouse_config']" position="inside">
                <group colspan="4">
                    <group string="Restreindre Accès" groups="orbit.admin_group_user">
                        <field name="is_restricted" />
                    </group>
                    <group></group>
                </group>
            </xpath>
        </field>
    </record>
    
</odoo>