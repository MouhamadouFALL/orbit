<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="orbit_purchase_order_action" model="ir.actions.act_window">
        <field name="name">Achat</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">form,tree,graph</field>
    </record>

    <record id="orbit_purchase_order_inherit" model="ir.ui.view">
        <field name="name">purchase.order.orbit.form.inherit.sale</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header/button[@name='button_draft']" position="replace">
                <button name="button_draft" states="cancel,to_validate" string="Marquer comme Brouillon" type="object" data-hotkey="o"/>
            </xpath>
            <xpath expr="//header/button[@name='button_confirm'][2]" position="replace">
                <!-- <button name="button_confirm" type="object" states="draft" string="Confirmer la commande" context="{'validate_analytic': True}" class="oe_highlight" id="bid_confirm" data-hotkey="v"/> -->
                <button name="button_confirm" type="object" states="to_validate" context="{'validate_analytic': True}" string="Confirmer la commande" id="draft_confirm"/>
            </xpath>

            <field name="state" position="replace">
                <field name="state" widget="statusbar" statusbar_visible="draft,sent,to_validate,purchase" readonly="1"/>
            </field>
            <field name="state" position="before">
                <button name="action_to_validation" 
                        string="Soumettre à validation"
                        type="object"
                        states="draft,sent"
                        class="oe_highlight" 
                        icon="fa-file-text"
                        data-hotkey="v"
                        groups="!orbit.ccbmshop_purchase_group_manager"
                />
            </field>

            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money" attrs="{'invisible': [('payment_count', '&lt;=', 0)]}">
                    <field name="payment_count" widget="statinfo" string="Paiements" />
                </button>
            </xpath>
            
            <xpath expr="//sheet/group" position="after">
                <group string="Documents joins">
                    <group >
                        <field name="attachment_ids" widget="many2many_binary" string="Attach a file" nolabel="1" colspan="2"/>
                    </group>
                    <group>
                    </group>
                </group>
            </xpath>

            <!-- Restriction de création et d'ouverture produit et fournisseur sur bon d'achat -->
            <!-- Produit -->
            <xpath expr="//field[@name='product_id']" position="attributes">
                <!-- <attribute name="options">{'no_create': True, 'no_open': True}</attribute> -->
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
            <!-- Fournisseur -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <field name="product_id" position="attributes">
                <attribute name="domain">[('product_tmpl_id.type','in', ['product', 'service'])]</attribute>
            </field>

        </field>
    </record>

    <!-- heritage de la vue liste de purchase.order -->
    <record id="view_orbit_purchase_order_inherited_tree" model="ir.ui.view">
        <field name="name">orbit.purchase.orbit.inherited.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='name']" position="after">
                <!-- <field name="date_approve" invisible="context.get('quotation_only', False)" optional="show"/> -->
                <!-- <field name="company_id" readonly="1" options="{'no_create': True}" groups="base.group_multi_company" optional="show"/> -->
                <field name="date_order" optional="show"/>
                <field name="date_approve" groups="orbit.ccbmshop_purchase_group_manager" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- heritage de la vue liste de purchase.order.line -->
    <record id="view_orbit_purchase_order_line_inherited_tree" model="ir.ui.view">
        <field name="name">orbit.purchase.order.line.orbit.inherited.tree</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='product_id']" position="attributes">
                <attribute name="domain">[('purchase_ok', '=', True), ('detailed_type', '!=', 'consu')]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
