<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="email_template_purchase_order_validation" model="mail.template">
        <field name="name">CCBMSHOP - Demande de validation du Bon d'achat</field>
        <field name="model_id" ref="orbit.model_purchase_order"/>
        <field name="subject">Validation requise pour le Bon d'achat {{object.name}}</field>
        <!-- <field name="email_from">${object.user_id.email}</field> -->
        <!-- <field name="email_from">{{object.company_id.email or 'ccbmshop.orbitcity@ccbm.sn'}}</field> -->
        <field name="email_from"></field>
        <!-- <field name="email_to">{{object.user_id.email}}</field> -->
        <field name="email_to"></field>
        <!-- <field name="email_cc">{{object.user_id.email}}</field> -->
        <field name="body_html" type="html">
                
                    <!-- Bloc Logo en haut de l'email -->
                    <!-- <div style="text-align:center; margin-bottom:15px;">
                        <img t-att-src="'/logo.png?company_id=%s' % (object.company_id.id or 0)" style="max-width:200px;" t-att-alt="'Logo %s' % object.company_id.name"/>
                    </div> -->

                    <!-- Bloc de texte -->
                    <div style="margin:0; padding:0;">
                        <p style="font-size: 13px;">
                            <!-- Bonjour <strong>Bara</strong> <strong><t t-esc="object.partner_id.name"/></strong>,<br/><br/> -->
                            Bonjour <strong>Bara</strong>,<br/><br/>
                            <p>Merci de valider le bon de commande <strong><span t-esc="object.name"/></strong> en cliquant sur le bouton ci-dessous.</p>
                            <p>
                                <a t-att-href="https://env['ir.config_parameter'].sudo().get_param('web.base.url') + '/web#id=' + str(object.id) + '&amp;view_type=form&amp;model=purchase.order'"
                                    style="background-color: #17a2b8; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; display: inline-block;">

                                    Valider <span t-esc="object.name"/>
                                </a>
                            </p>
                            <p>Cordialement,<br/><strong><t t-esc="object.company_id.name"/></strong></p>
                        </p>
                    </div>

            </field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
